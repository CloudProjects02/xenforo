<xf:macro id="ban_details" arg-ban="!" arg-type="board" arg-thread="" arg-forum="">
	<xf:if contentcheck="true">
		<div class="siropuEasyUserBanBanDetails">
			<xf:contentcheck>
				<xf:if is="$xf.options.siropuEasyUserBanDisplayBanDetails">
					<xf:if is="$type == 'thread' AND $thread is empty">
						<b>{{ phrase('thread:') }}</b> <a href="{{ link('threads', $ban.Thread) }}" class="u-concealed">{$ban.Thread.title}</a><br>
					<xf:elseif is="$type == 'forum' AND $forum is empty" />
						<b>{{ phrase('forum:') }}</b> <a href="{{ link('forums', $ban.Forum) }}" class="u-concealed">{$ban.Forum.title}</a><br>
					</xf:if>
					<b>{{ phrase('ban_ends:') }}</b> {{ $ban.end_date ? date_time($ban.end_date) : phrase('never') }}
					<br>
					<b>{{ phrase('banned_by:') }}</b> <xf:username user="$ban.BanUser" rich="true" class="u-concealed" />, <xf:date time="$ban.ban_date" />
					<xf:if is="$ban.user_reason AND $xf.visitor.hasPermission('siropuEasyUserBan', 'viewBanReason')">
						<br>
						<b>{{ phrase('reason_for_banning:') }}</b> <a role="button" data-xf-click="siropu-easy-user-ban-toggle-reason" class="u-concealed">{{ phrase('view') }}</a>
						<div class="siropuEasyUserBanBanReason">{$ban.user_reason}</div>
					</xf:if>
				</xf:if>
				<xf:if is="$xf.visitor.hasPermission('siropuEasyUserBanMod', 'unban')">
					<br>
					<a href="{{ link('members/quick-unban', $ban.User, $ban.getLinkParams()) }}" data-xf-click="overlay">{{ phrase('lift_ban') }}</a>
				</xf:if>
			</xf:contentcheck>
		</div>
	</xf:if>
</xf:macro>]]></template>
