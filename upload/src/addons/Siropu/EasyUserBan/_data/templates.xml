  <template type="public" title="siropu_easy_user_ban_ip_ban" version_id="2010070" version_string="2.1.0"><![CDATA[<xf:title>{{ phrase('add_ip_ban') }}</xf:title>

<xf:form action="{{ link('members/ban-ip') }}" ajax="true" class="block">
