  <template type="public" title="siropu_easy_user_ban_forum_bans" version_id="2010270" version_string="2.1.2"><![CDATA[<xf:if is="$forum is not empty">
	<xf:title>{{ phrase('siropu_easy_user_ban_forum_bans:') }} {$forum.title}</xf:title>
<xf:else />
	<xf:title>{{ phrase('siropu_easy_user_ban_forum_bans') }}</xf:title>
</xf:if>

<xf:css src="siropu_easy_user_ban_user_ban_list.less" />
<xf:js src="siropu/eub/moderator.js" min="1" />

<xf:form action="{{ link('forums/user-bans') }}" class="block">
	<div class="block-container">
		<div class="block-body block-row">
			<xf:textbox type="search" name="username" placeholder="{{ phrase('user_name...') }}" value="{$username}" class="input--inline" data-xf-init="auto-complete" data-single="true" />
			<xf:button type="submit" icon="search">{{ phrase('find') }}</xf:button>
		</div>
	</div>
</xf:form>

<div class="block">
	<div class="block-container">
		<xf:macro id="siropu_easy_user_ban_macros::user_ban_type_tab" arg-type="forum" />
		<ol class="block-body siropuEasyUserBan">
			<xf:foreach loop="$bans" value="$ban">
				<xf:set var="$extraData">
					<xf:macro id="siropu_easy_user_ban_user_ban_list::ban_details" arg-ban="{$ban}" arg-type="forum" arg-forum="{$forum}" />
				</xf:set>
				<li class="block-row block-row--separated">
