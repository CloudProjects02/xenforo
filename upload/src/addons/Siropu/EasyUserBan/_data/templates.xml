			<xf:button href="{{ link('threads/user-bans') }}" class="button--primary"><xf:fa icon="far fa-arrow-right" /> {{ phrase('siropu_easy_user_ban_thread_bans') }}</xf:button>
		</div>
	</div>
</xf:pageaction>

<xf:form action="{{ link('members/banned', '', {'type': $banType}) }}" class="block">
	<div class="block-container">
		<div class="block-body block-row">
			<xf:textbox type="search" name="username" placeholder="{{ phrase('user_name...') }}" value="{$username}" class="input--inline" />
			<xf:button type="submit" icon="search">{{ phrase('find') }}</xf:button>
		</div>
	</div>
</xf:form>

<div clas="block">
	<div class="block-container">
		<h2 class="block-tabHeader tabs">
			<a href="{{ link('members/banned') }}" class="tabs-tab{{ $banType == '' ? ' is-active' : '' }}">{{ phrase('all') }}</a>
			<a href="{{ link('members/banned', '', {'type': 'temp'}) }}" class="tabs-tab{{ $banType == 'temp' ? ' is-active' : '' }}">{{ phrase('temporary') }}</a>
			<a href="{{ link('members/banned', '', {'type': 'perm'}) }}" class="tabs-tab{{ $banType == 'perm' ? ' is-active' : '' }}">{{ phrase('permanent') }}</a>
		</h2>
		<ol class="block-body siropuEasyUserBan">
			<xf:foreach loop="$userBans" value="$ban">
				<xf:set var="$extraData">
					<xf:macro id="ban_details" arg-ban="{$ban}" />
				</xf:set>
				<li class="block-row block-row--separated">
					<xf:macro id="member_list_macros::item"
							  arg-user="{$ban.User}"
							  arg-extraData="{$extraData}"
							  arg-extraDataBig="{{ true }}" />
				</li>
