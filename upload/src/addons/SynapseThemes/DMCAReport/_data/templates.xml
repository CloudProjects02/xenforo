}) }}
]]></template>
  <template type="public" title="st_dmca_index" version_id="100" version_string="1.0.0"><![CDATA[<xf:title>DMCA Takedown Request</xf:title>

<div class="block">
    <div class="block-container">
        <div class="block-body">
            <div class="block-row">
                <h2>What is DMCA?</h2>
                <p>The Digital Millennium Copyright Act (DMCA) is a United States copyright law that implements two 1996 treaties of the World Intellectual Property Organization (WIPO). It criminalizes production and dissemination of technology, devices, or services intended to circumvent measures that control access to copyrighted works.</p>
                
                <h3>When to file a DMCA takedown request?</h3>
                <p>You should file a DMCA takedown request if:</p>
                <ul>
                    <li>You own the copyright to the content in question</li>
                    <li>You are authorized to act on behalf of the copyright owner</li>
                    <li>You believe your copyrighted work is being used without permission</li>
                </ul>

                <h3>What happens after filing?</h3>
                <p>Once you submit a DMCA takedown request:</p>
                <ul>
                    <li>Our team will review your request</li>
                    <li>If valid, the content will be removed</li>
                    <li>The content poster will be notified and may file a counter-notice</li>
                    <li>You will be notified of any actions taken</li>
                </ul>
            </div>
        </div>
        <div class="block-footer">
            <a href="{{ link('dmca/report') }}" class="button button--primary">File a DMCA Report</a>
        </div>
    </div>
</div> ]]></template>
  <template type="public" title="st_dmca_report_form" version_id="101" version_string="1.0.1"><![CDATA[<xf:title>{{ phrase('submit_dmca_report') }}</xf:title>

<xf:form action="{{ link('dmca/report') }}" class="block" ajax="true">
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="title" value="{{ $report.title }}"
                label="{{ phrase('report_title') }}"
                required="required"
                explain="{{ phrase('dmca_report_title_explain') }}" />

            <xf:textboxrow name="copyright_owner" value="{{ $report.copyright_owner }}"
                label="{{ phrase('copyright_owner') }}"
                required="required"
                explain="{{ phrase('copyright_owner_explain') }}" />

            <xf:if is="!$xf.visitor.user_id">
                <xf:textboxrow name="email" value="{{ $report.email }}"
                    type="email"
                    label="{{ phrase('email') }}"
                    required="required"
                    explain="{{ phrase('email_explain') }}" />
            </xf:if>                

            <xf:selectrow name="dmca_type" value="{{ $report.dmca_type }}"
                label="{{ phrase('dmca_type') }}"
                required="required"
                explain="{{ phrase('dmca_type_explain') }}">
                <xf:option value="copyright">{{ phrase('dmca_type_copyright') }}</xf:option>
                <xf:option value="trademark">{{ phrase('dmca_type_trademark') }}</xf:option>
                <xf:option value="patent">{{ phrase('dmca_type_patent') }}</xf:option>
            </xf:selectrow>

            <xf:textarearow name="content_urls" value="{{ $report.content_urls }}" rows="3"
                label="{{ phrase('infringing_content_urls') }}"
                required="required"
                explain="{{ phrase('dmca_urls_explain') }}" />

            <xf:textarearow name="original_content_urls" value="{{ $report.original_content_urls }}" rows="3"
                label="{{ phrase('original_content_urls') }}"
                required="required"
                explain="{{ phrase('dmca_urls_explain') }}" />

            <xf:textarearow name="content_description" value="{{ $report.content_description }}" rows="5"
                label="{{ phrase('description') }}"
                required="required"
                explain="{{ phrase('content_description_explain') }}" />
        </div>

        <xf:submitrow icon="submit" />
    </div>
</xf:form> ]]></template>
  <template type="public" title="st_dmca_success" version_id="100" version_string="1.0.0"><![CDATA[<xf:title>DMCA Report Submitted</xf:title>

<div class="blockMessage blockMessage--success">
    <h2>Thank you for your report</h2>
    <p>Your DMCA takedown request has been successfully submitted. Our team will review your report and take appropriate action.</p>
    <p>You will be notified via email about any updates regarding your report.</p>
    
    <div class="block-row">
        <a href="{{ link('index') }}" class="button">Return to Homepage</a>
    </div>
</div> ]]></template>
</templates>
