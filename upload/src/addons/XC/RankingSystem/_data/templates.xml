  <template type="admin" title="level_edit" version_id="2040520" version_string="2.4.5 Alpha"><![CDATA[<xf:if is="$level.isInsert()">
	<xf:title>{{ phrase('xc_level_add') }}</xf:title>
<xf:else />
	<xf:title>{{ phrase('xc_level_edit:') }} {$level.level}</xf:title>
</xf:if>

<xf:form action="{{ link('levels/save', $level) }}" ajax="true" class="block" enctype="multipart/form-data">	
	
	<div class="block-container">
			<div class="block-body">
				<xf:formrow label="{{ phrase('xc_level') }}">
					<xf:numberbox name="level" value="{$level.level}"
						size="5" min="0" step="1" />
				</xf:formrow>
				<xf:formrow label="{{ phrase('xc_exp_points') }}">
						<xf:numberbox name="exp_points" value="{$level.exp_points}"
						size="5" min="0" step="1" />
				</xf:formrow>
				
				<xf:formrow label="{{ phrase('level_badge_image') }}" explain="{{ phrase('level_badge_image_explain') }}">
					<xf:upload name="badge_image" accept=".svg,.png,.jpg,.jpeg,.gif" />
					<xf:if is="!$level.isInsert() AND $level.LevelBadge AND $level.LevelBadge.getImageExists()">
						<div class="formRow-explain">
							<img src="{$level.LevelBadge.getImgPath()}" alt="Current badge" style="max-width: 100px; max-height: 100px;" />
						</div>
					</xf:if>
				</xf:formrow>
				
			</div>
			<xf:submitrow icon="save" rowtype="simple" />
		</div>
	</xf:form>]]></template>
  <template type="admin" title="level_list" version_id="1040010" version_string="1.4.0 Alpha"><![CDATA[<xf:title>{{ phrase('xc_levels') }}</xf:title>

<xf:pageaction>
	<xf:button href="{{ link('levels/add') }}" overlay="true" icon="add">{{ phrase('xc_add_level') }}</xf:button>
	<xf:button href="{{ link('levels/import') }}" overlay="true" icon="add">{{ phrase('xc_import_level') }}</xf:button>
</xf:pageaction>
<xf:if is="$doc">
<xf:inforow>
	<div class="blockMessage blockMessage--important blockMessage--iconic">{{ phrase('xc_file_is_impmorting', {'doc': $doc.doc_title}) }}</div>
</xf:inforow>
</xf:if>
<div class="block-container">
		<xf:if is="$levellist is not empty">
			<div class="block-body">
				
				<xf:datalist data-xf-init="responsive-data-list">
					<xf:datarow rowtype="header">
						<xf:cell>{{ phrase('xc_level') }}</xf:cell>
						<xf:cell>{{ phrase('xc_experience_point') }}</xf:cell>
						<xf:cell class="dataList-cell--min">&nbsp;</xf:cell>
						<xf:cell class="dataList-cell--min">&nbsp;</xf:cell>
					</xf:datarow>
					<xf:foreach loop="$levellist" value="$levelone">
						<xf:datarow>
							<xf:cell>{$levelone.level}</xf:cell>
							<xf:cell>{$levelone.exp_points}</xf:cell>
							<xf:action href="{{ link('levels/edit', $levelone) }}" overlay="true">{{ phrase('edit') }}</xf:action>
							<xf:delete href="{{ link('levels/delete', $levelone) }}" />
						</xf:datarow>
					</xf:foreach>
				</xf:datalist>
			</div>
			<div class="block-footer">
				<span class="block-footer-counter">{{ display_totals($levellist, $total) }}</span>
			</div>
		<xf:else />
			<div class="block-body block-row">{{ phrase('no_results_found') }}</div>
		</xf:if>
