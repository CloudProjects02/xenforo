</xf:if>
<xf:if is="$user.canModerate() and $xf.options.andrewModeratorPanelModeratedUsergroup > 0">
		<xf:if is="$user.isMemberOf($xf.options.andrewModeratorPanelModeratedUsergroup)">
			<a href="{{ link('members/remove-moderate', $user) }}" class="menu-linkRow" data-xf-click="overlay">	
				{{ phrase('andrew_moderatorpanel_remove_moderation') }}
			</a>
			<xf:else />
			<a href="{{ link('members/moderate', $user) }}" class="menu-linkRow" data-xf-click="overlay">
				{{ phrase('andrew_moderatorpanel_moderate') }}
			</a>
		</xf:if>
	</a>
</xf:if>
<xf:if is="$user.canUpdateUserGroup()">
	<a href="{{ link('members/update-user-group', $user) }}" class="menu-linkRow" data-xf-click="overlay">
		{{ phrase('andrew_moderatorpanel_update_user_group') }}
	</a>
</xf:if>
$0]]></replace>
