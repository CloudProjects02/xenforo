		<xf:if is="$user.Option.is_discouraged">
			<a href="{{ link('members/remove-discourage', $user) }}" class="menu-linkRow" data-xf-click="overlay">
				{{ phrase('andrew_moderatorpanel_remove_discourage') }}
			</a>
			<xf:else />
			<a href="{{ link('members/discourage', $user) }}" class="menu-linkRow" data-xf-click="overlay">
				{{ phrase('discourage') }}
