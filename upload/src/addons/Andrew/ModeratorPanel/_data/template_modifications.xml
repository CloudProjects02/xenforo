    <replace><![CDATA[<xf:if is="$user.canForceIgnoreMP()">
	<a href="{{ link('members/force-ignore', $user) }}" class="menu-linkRow" data-xf-click="overlay">
		{{ phrase('andrew_moderatorpanel_force_ignore') }}
	</a>
