  <modification type="admin" template="permission_analyze" modification_key="dbtech_shop_permission_analyze" description="Add additional if checks to permission analysis" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:if is="$intermediate.type == 'system'">]]></find>
    <replace><![CDATA[<xf:if is="$intermediate.type == 'shop-category-system'">
										<xf:if is="$intermediate.contentId">
											{$intermediate.contentTitle} - {{ phrase('dbtech_shop_category_wide') }}
										<xf:else />
											{{ phrase('dbtech_shop_category_wide') }}
										</xf:if>
									<xf:elseif is="$intermediate.type == 'shop-category-group'" />
										<xf:if is="$intermediate.contentId">
											{$intermediate.contentTitle} - {{ phrase('parent_category') }}
										<xf:else />
											{$userGroupTitles.{$intermediate.typeId}}
										</xf:if>
									<xf:elseif is="$intermediate.type == 'shop-category-user'" />
										<xf:if is="$intermediate.contentId">
											{$intermediate.contentTitle} - {{ phrase('dbtech_shop_user_value_parent_category') }}
										<xf:else />
											{{ phrase('dbtech_shop_user_value_parent_category') }}
										</xf:if>
									</xf:if>
									$0]]></replace>
  </modification>
