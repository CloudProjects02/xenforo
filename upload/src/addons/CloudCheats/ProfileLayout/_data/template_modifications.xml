<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="member_view" modification_key="cc_profile_layout" description="CloudCheats Profile Layout - two-column sidebar" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<div class="block">
	<div class="block-container">
		<div class="block-body">
			<div class="memberHeader {{ $user.Profile.banner_date ? 'memberHeader--withBanner' : '' }}">
				<xf:profilebanner user="$user" size="l" class="memberHeader-main" toggle="memberHeader--withBanner">
					<div class="memberHeader-mainContent">
						<span class="memberHeader-avatar">
							<span class="avatarWrapper">
								<xf:avatar user="{$user}" size="l"
									href="{{ $user.getAvatarUrl('o') ?: '' }}" />
								<xf:if is="$user.user_id == $xf.visitor.user_id && $xf.visitor.canUploadAvatar()">
									<a class="avatarWrapper-update" href="{{ link('account/avatar') }}" data-xf-click="overlay"><span>{{ phrase('edit') }}</span></a>
								</xf:if>
							</span>
						</span>
						<div class="memberHeader-content memberHeader-content--info">
						<xf:if contentcheck="true">
							<div class="memberHeader-actionTop">
								<xf:contentcheck>
								<!--[XF:action_top_start]-->
								<xf:if contentcheck="true">
									<div class="buttonGroup">
										<xf:contentcheck>
											<xf:if is="$user.canBeReported()">
												<xf:button href="{{ link('members/report', $user) }}"
													class="button--link" overlay="true" data-cache="false">
													{{ phrase('report_verb') }}
												</xf:button>
											</xf:if>
											<xf:if is="$user.user_id == $xf.visitor.user_id && $xf.visitor.canUploadProfileBanner()">
												<xf:button href="{{ link('account/banner') }}"
													class="button--link" overlay="true">
													{{ phrase('edit_profile_banner') }}
												</xf:button>
											</xf:if>
											<xf:if contentcheck="true">
												<div class="buttonGroup-buttonWrapper">
													<xf:button class="button--link menuTrigger" data-xf-click="menu" aria-expanded="false" aria-haspopup="true">{{ phrase('moderator_tools') }}</xf:button>
													<div class="menu" data-menu="menu" aria-hidden="true">
														<div class="menu-content">
															<h3 class="menu-header">{{ phrase('moderator_tools') }}</h3>
															<xf:contentcheck>
																<xf:macro id="member_macros::moderator_menu_actions"
																	arg-user="{$user}"
																	arg-context="profile" />
															</xf:contentcheck>
														</div>
													</div>
												</div>
											</xf:if>
										</xf:contentcheck>
									</div>
								</xf:if>
								<!--[XF:action_top_end]-->
								</xf:contentcheck>
							</div>
						</xf:if>

						<h1 class="memberHeader-name">
							<span class="memberHeader-nameWrapper">
								<xf:username user="{$user}" rich="true" href="" />
							</span>
							<xf:if is="$user.hasViewableUsernameHistory()">
								<a class="memberHeader-nameChangeIndicator"
									data-xf-click="menu"
									data-xf-init="tooltip"
									title="{{ phrase('username_changed')|for_attr }}"
									role="button"
									tabindex="0"
									aria-expanded="false"
									aria-haspopup="true"
									aria-label="{{ phrase('username_changed')|for_attr }}"><xf:fa icon="fa-history" /></a>
								<div class="menu" data-menu="menu" aria-hidden="true"
									data-href="{{ link('members/username-history', $user, {'menu': 1}) }}"
									data-load-target=".js-usernameHistoryBody">
									<div class="menu-content">
										<h3 class="menu-header">{{ phrase('previous_usernames') }}</h3>
										<div class="js-usernameHistoryBody">
											<div class="menu-row">
												{{ phrase('loading...') }}
											</div>
										</div>
									</div>
								</div>
							</xf:if>
						</h1>

						<xf:if contentcheck="true">
							<div class="memberHeader-banners">
								<xf:contentcheck><xf:userbanners user="$user" /></xf:contentcheck>
							</div>
						</xf:if>

						<div class="memberHeader-blurbContainer">
							<xf:userblurb user="$user" tag="div" class="memberHeader-blurb" />

							<div class="memberHeader-blurb">
								<dl class="pairs pairs--inline">
									<dt>{{ phrase('joined') }}</dt>
									<dd><xf:date time="$user.register_date" /></dd>
								</dl>
							</div>

							<xf:if contentcheck="true">
								<div class="memberHeader-blurb">
									<dl class="pairs pairs--inline">
										<dt>{{ phrase('last_seen') }}</dt>
										<dd dir="auto">
											<xf:contentcheck><xf:useractivity user="$user" class="pairs--plainLabel" /></xf:contentcheck>
										</dd>
									</dl>
								</div>
							</xf:if>
						</div>
					</div>
					</div>
				</xf:profilebanner>

				<div class="memberHeader-content">
					<div class="memberHeader-stats">
						<div class="pairJustifier">
							<xf:macro id="member_macros::member_stat_pairs"
								arg-user="{$user}"
								arg-context="profile" />
						</div>
					</div>

					<xf:if contentcheck="true">
						<hr class="memberHeader-separator" />

						<div class="memberHeader-buttons">
							<xf:contentcheck>
								<xf:macro id="member_macros::member_action_buttons"
									arg-user="{$user}"
									arg-context="profile" />
							</xf:contentcheck>
						</div>
					</xf:if>
				</div>

			</div>
		</div>
		<h2 class="block-tabHeader block-tabHeader--memberTabs tabs hScroller"
			data-xf-init="tabs h-scroller"
			data-panes=".js-memberTabPanes"
			data-state="replace"
			role="tablist">
			<span class="hScroller-scroll">
				<!--[XF:tabs:start]-->
				<xf:if is="$user.canViewPostsOnProfile()">
					<a href="{{ link('members', $user) }}"
						class="tabs-tab is-active"
						role="tab"
						aria-controls="profile-posts">{{ phrase('profile_posts') }}</a>
				</xf:if>

				<xf:if is="$user.canViewLatestActivity()">
					<xf:if is="!$user.canViewPostsOnProfile()">
						<a href="{{ link('members', $user) }}"
							class="tabs-tab is-active"
							role="tab"
							aria-controls="latest-activity">{{ phrase('latest_activity') }}</a>
					<xf:else />
						<a href="{{ link('members/latest-activity', $user) }}"
							rel="nofollow"
							class="tabs-tab"
							id="latest-activity"
							role="tab">{{ phrase('latest_activity') }}</a>
					</xf:if>
				</xf:if>

				<a href="{{ link('members/recent-content', $user) }}"
					rel="nofollow"
					class="tabs-tab"
					id="recent-content"
					role="tab">{{ phrase('postings') }}</a>

				<!--[XF:tabs:after_recent_content]-->

				<a href="{{ link('members/about', $user) }}"
					class="tabs-tab"
					id="about"
					role="tab">{{ phrase('about') }}</a>

				<xf:if is="$xf.visitor.canViewWarnings() && $user.warning_count">
					<a href="{{ link('members/warnings', $user) }}"
						class="tabs-tab"
						id="warnings"
						role="tab">{{ phrase('warnings') }}</a>
				</xf:if>
				<!--[XF:tabs:end]-->
			</span>
		</h2>
	</div>
</div>

<xf:ad position="member_view_below_tabs" arg-user="{$user}" />

<ul class="tabPanes js-memberTabPanes">
	<!--[XF:tab_panes:start]-->
	<xf:if is="$user.canViewPostsOnProfile()">
		<li class="is-active" role="tabpanel" id="profile-posts">
			<xf:js src="xf/inline_mod.js" min="1" />

			<xf:macro id="lightbox_macros::setup" arg-canViewAttachments="{$canViewAttachments}" />

			<div class="block block--messages"
				data-xf-init="lightbox inline-mod"
				data-type="profile_post"
				data-href="{{ link('inline-mod') }}">

				<div class="block-container">
					<div class="block-body js-replyNewMessageContainer">
						<xf:if is="$user.canPostOnProfile()">
							<xf:set var="$firstProfilePost" value="{$profilePosts|first}" />
							<xf:macro id="profile_post_macros::quick_post"
								arg-user="{$user}"
								arg-lastDate="{{ $firstProfilePost.post_date ?: 0 }}"
								arg-containerSelector="< .js-replyNewMessageContainer"
								arg-attachmentData="{$attachmentData}" />
						</xf:if>

						<xf:if is="$profilePosts is not empty">
							<xf:foreach loop="$profilePosts" value="$profilePost">
								<xf:macro id="profile_post_macros::{{ $profilePost.message_state == 'deleted' ? 'profile_post_deleted' : 'profile_post' }}"
									arg-attachmentData="{$profilePostAttachData.{$profilePost.profile_post_id}}"
									arg-profilePost="{$profilePost}" />
							</xf:foreach>
						<xf:else />
							<div class="block-row js-replyNoMessages">{{ phrase('there_no_messages_on_xs_profile_yet', {'name': $user.username}) }}</div>
						</xf:if>
					</div>
				</div>

				<div class="block-outer block-outer--after">
					<xf:pagenav
						page="{$page}" perpage="{$perPage}" total="{$total}"
						link="members" data="{$user}"
						wrapperclass="block-outer-main" />
					<div class="block-outer-opposite">
						<xf:showignored />
						<xf:if is="$canInlineMod">
							<xf:macro id="inline_mod_macros::button" />
						</xf:if>
					</div>
				</div>
			</div>
		</li>
	</xf:if>

	<xf:if is="$user.canViewLatestActivity()">
		<xf:if is="!$user.canViewPostsOnProfile()">
			<li class="is-active" role="tabpanel" id="latest-activity">
				<div class="block">
					<div class="block-container">
						<xf:if is="$newsFeedItems is not empty">
							<ul class="block-body js-newsFeedTarget">
								<xf:foreach loop="$newsFeedItems" value="$item">
									<xf:macro id="news_feed_macros::feed_row" arg-item="{$item}" />
								</xf:foreach>
							</ul>
							<div class="block-footer js-newsFeedLoadMore">
								<span class="block-footer-controls"><xf:button href="{{ link('members/latest-activity', $user, {'before_id': $newsFeedOldestItemId}) }}"
									rel="nofollow"
									data-xf-click="inserter"
									data-append=".js-newsFeedTarget"
									data-replace=".js-newsFeedLoadMore">
									{{ phrase('show_older_items') }}
								</xf:button></span>
							</div>
							<xf:else />
							<div class="block-body js-newsFeedTarget">
								<div class="block-row">{{ phrase('news_feed_is_currently_empty') }}</div>
							</div>
						</xf:if>
					</div>

					<div class="block-outer block-outer--after">
						<div class="block-outer-opposite">
							<xf:showignored />
						</div>
					</div>
				</div>
			</li>
		<xf:else />
			<li data-href="{{ link('members/latest-activity', $user) }}" role="tabpanel" aria-labelledby="latest-activity">
				<div class="blockMessage">{{ phrase('loading...') }}</div>
			</li>
		</xf:if>
	</xf:if>

	<li data-href="{{ link('members/recent-content', $user) }}" role="tabpanel" aria-labelledby="recent-content">
		<div class="blockMessage">{{ phrase('loading...') }}</div>
	</li>

	<!--[XF:tab_panes:after_recent_content]-->

	<li data-href="{{ link('members/about', $user) }}" role="tabpanel" aria-labelledby="about">
		<div class="blockMessage">{{ phrase('loading...') }}</div>
	</li>

	<xf:if is="$xf.visitor.canViewWarnings() && $user.warning_count">
		<li data-href="{{ link('members/warnings', $user) }}" role="tabpanel" aria-labelledby="warnings">
			<div class="blockMessage">{{ phrase('loading...') }}</div>
		</li>
	</xf:if>
	<!--[XF:tab_panes:end]-->
</ul>]]></find>
    <replace><![CDATA[<xf:css src="cc_profile.less" />

<div class="cc-profile-wrap">

    <!-- ── Header cover ── -->
    <div class="cc-profile-cover">
        <xf:profilebanner user="$user" size="l" class="cc-banner-bg" toggle="cc-profile-cover--hasBanner">
            <div class="cc-profile-header">

                <div class="cc-avatar-ring">
                    <span class="avatarWrapper">
                        <xf:avatar user="{$user}" size="l" href="{{ $user.getAvatarUrl('o') ?: '' }}" />
                        <xf:if is="$user.user_id == $xf.visitor.user_id && $xf.visitor.canUploadAvatar()">
                            <a class="avatarWrapper-update" href="{{ link('account/avatar') }}" data-xf-click="overlay"><span>{{ phrase('edit') }}</span></a>
                        </xf:if>
                    </span>
                </div>

                <div class="cc-header-info">
                    <h1 class="cc-username">
                        <xf:username user="{$user}" rich="true" href="" />
                        <xf:if is="$user.hasViewableUsernameHistory()">
                            <a class="cc-username-history-trigger"
                               data-xf-click="menu" data-xf-init="tooltip"
                               title="{{ phrase('username_changed')|for_attr }}"
                               role="button" tabindex="0" aria-expanded="false" aria-haspopup="true"><i class="fas fa-history"></i></a>
                            <div class="menu" data-menu="menu" aria-hidden="true"
                                 data-href="{{ link('members/username-history', $user, {'menu': 1}) }}"
                                 data-load-target=".js-usernameHistoryBody">
                                <div class="menu-content">
                                    <h3 class="menu-header">{{ phrase('previous_usernames') }}</h3>
                                    <div class="js-usernameHistoryBody"><div class="menu-row">{{ phrase('loading...') }}</div></div>
                                </div>
                            </div>
                        </xf:if>
                    </h1>
                    <xf:userblurb user="$user" tag="div" class="cc-header-blurb" />
                </div>

                <div class="cc-header-actions">
                    <xf:if contentcheck="true">
                        <xf:contentcheck>
                            <xf:macro id="member_macros::member_action_buttons" arg-user="{$user}" arg-context="profile" />
                        </xf:contentcheck>
                    </xf:if>
                    <xf:if contentcheck="true">
                        <div class="cc-staff-tools">
                            <xf:contentcheck>
                                <!--[XF:action_top_start]-->
                                <xf:if is="$user.user_id == $xf.visitor.user_id && $xf.visitor.canUploadProfileBanner()">
                                    <a href="{{ link('account/banner') }}" class="button button--link" data-xf-click="overlay">{{ phrase('edit_profile_banner') }}</a>
                                </xf:if>
                                <xf:if contentcheck="true">
                                    <div class="buttonGroup-buttonWrapper">
                                        <a class="button button--link menuTrigger" data-xf-click="menu" aria-expanded="false" aria-haspopup="true">{{ phrase('moderator_tools') }}</a>
                                        <div class="menu" data-menu="menu" aria-hidden="true">
                                            <div class="menu-content">
                                                <h3 class="menu-header">{{ phrase('moderator_tools') }}</h3>
                                                <xf:contentcheck>
                                                    <xf:macro id="member_macros::moderator_menu_actions" arg-user="{$user}" arg-context="profile" />
                                                </xf:contentcheck>
                                            </div>
                                        </div>
                                    </div>
                                </xf:if>
                                <!--[XF:action_top_end]-->
                            </xf:contentcheck>
                        </div>
                    </xf:if>
                </div>

            </div>
        </xf:profilebanner>
    </div>

    <!-- ── Three-column body ── -->
    <div class="cc-profile-body">

        <!-- ── LEFT SIDEBAR ── -->
        <div class="cc-profile-sidebar">

            <!-- Online / Offline status -->
            <div class="cc-sidebar-card cc-status-card{{ $user.isOnline() ? ' cc-status--online' : ' cc-status--offline' }}">
                <div class="cc-status-main">
                    <span class="cc-status-dot"></span>
                    <span class="cc-status-label">{{ $user.isOnline() ? 'ONLINE' : 'OFFLINE' }}</span>
                </div>
                <xf:if contentcheck="true">
                    <div class="cc-status-sub">
                        <xf:contentcheck><xf:useractivity user="$user" /></xf:contentcheck>
                    </div>
                </xf:if>
            </div>

            <!-- Reputation / Points blocks (vacban style) -->
            <div class="cc-rep-grid">
                <div class="cc-rep-block">
                    <div class="cc-rep-num">{{ $user.reaction_score }}</div>
                    <div class="cc-rep-label">Reputations</div>
                    <div class="cc-rep-icon"><i class="fas fa-exclamation-circle"></i></div>
                </div>
                <div class="cc-rep-block">
                    <div class="cc-rep-num">{{ $user.trophy_points }}</div>
                    <div class="cc-rep-label">Points</div>
                    <div class="cc-rep-icon"><i class="fas fa-star"></i></div>
                </div>
            </div>

            <!-- Info rows -->
            <div class="cc-sidebar-card cc-info-card">
                <div class="cc-info-row">
                    <span class="cc-info-label"><i class="fas fa-user-circle"></i> User ID</span>
                    <span class="cc-info-val">#{{ $user.user_id }}</span>
                </div>
                <div class="cc-info-row">
                    <span class="cc-info-label"><i class="fas fa-calendar-check"></i> Registered</span>
                    <span class="cc-info-val"><xf:date time="$user.register_date" /></span>
                </div>
                <xf:if contentcheck="true">
                    <div class="cc-info-row">
                        <span class="cc-info-label"><i class="fas fa-clock"></i> Last Visited</span>
                        <span class="cc-info-val">
                            <xf:contentcheck><xf:useractivity user="$user" /></xf:contentcheck>
                        </span>
                    </div>
                </xf:if>
                <xf:if is="$user.hasViewableUsernameHistory()">
                    <div class="cc-info-row">
                        <span class="cc-info-label"><i class="fas fa-history"></i> Username History</span>
                        <span class="cc-info-val">
                            <a style="color:@xf-textColorMuted;" data-xf-click="menu" role="button" tabindex="0" aria-expanded="false" aria-haspopup="true">View</a>
                            <div class="menu" data-menu="menu" aria-hidden="true"
                                 data-href="{{ link('members/username-history', $user, {'menu': 1}) }}"
                                 data-load-target=".js-usernameHistoryBody2">
                                <div class="menu-content">
                                    <h3 class="menu-header">{{ phrase('previous_usernames') }}</h3>
                                    <div class="js-usernameHistoryBody2"><div class="menu-row">{{ phrase('loading...') }}</div></div>
                                </div>
                            </div>
                        </span>
                    </div>
                </xf:if>
                <div class="cc-info-row">
                    <span class="cc-info-label"><i class="fas fa-comment"></i> Posts</span>
                    <span class="cc-info-val">{{ $user.message_count }}</span>
                </div>
            </div>

        </div>

        <!-- ── CENTER CONTENT ── -->
        <div class="cc-profile-content">

            <!-- Horizontal stats grid -->
            <div class="cc-sidebar-card cc-stats-card">
                <div class="cc-stats-hgrid">
                    <xf:macro id="member_macros::member_stat_pairs" arg-user="{$user}" arg-context="profile" />
                </div>
            </div>

            <!-- Decorative banners strip (horizontal) -->
            <xf:if contentcheck="true">
                <div class="cc-banners-strip">
                    <xf:contentcheck><xf:userbanners user="$user" /></xf:contentcheck>
                </div>
            </xf:if>

            <!-- About / Signature inline card -->
            <div class="cc-about-card" data-xf-init="tabs" data-panes=".cc-about-panes">
                <div class="cc-about-tabs tabs" role="tablist">
                    <a class="tabs-tab is-active" role="tab" aria-controls="cc-about-about">About</a>
                    <a class="tabs-tab" role="tab" aria-controls="cc-about-sig">Signature</a>
                </div>
                <ul class="cc-about-panes">
                    <li class="is-active cc-about-pane" id="cc-about-about" role="tabpanel">
                        <xf:if is="$user.Profile.about">
                            {{ bb_code($user.Profile.about, 'user:about', $user) }}
                        <xf:else />
                            <span class="cc-about-empty">This user hasn't written anything yet.</span>
                        </xf:if>
                    </li>
                    <li class="cc-about-pane" id="cc-about-sig" role="tabpanel">
                        <xf:if is="$user.Profile.signature">
                            {{ bb_code($user.Profile.signature, 'user:signature', $user) }}
                        <xf:else />
                            <span class="cc-about-empty">No signature.</span>
                        </xf:if>
                    </li>
                </ul>
            </div>

            <xf:ad position="member_view_below_tabs" arg-user="{$user}" />

            <!-- Main tab bar -->
            <h2 class="block-tabHeader block-tabHeader--memberTabs tabs hScroller"
                data-xf-init="tabs h-scroller"
                data-panes=".js-memberTabPanes"
                data-state="replace"
                role="tablist">
                <span class="hScroller-scroll">
                    <!--[XF:tabs:start]-->
                    <xf:if is="$user.canViewPostsOnProfile()">
                        <a href="{{ link('members', $user) }}" class="tabs-tab is-active" role="tab" aria-controls="profile-posts">{{ phrase('profile_posts') }}</a>
                    </xf:if>
                    <xf:if is="$user.canViewLatestActivity()">
                        <xf:if is="!$user.canViewPostsOnProfile()">
                            <a href="{{ link('members', $user) }}" class="tabs-tab is-active" role="tab" aria-controls="latest-activity">{{ phrase('latest_activity') }}</a>
                        <xf:else />
                            <a href="{{ link('members/latest-activity', $user) }}" rel="nofollow" class="tabs-tab" id="latest-activity" role="tab">{{ phrase('latest_activity') }}</a>
                        </xf:if>
                    </xf:if>
                    <a href="{{ link('members/recent-content', $user) }}" rel="nofollow" class="tabs-tab" id="recent-content" role="tab">{{ phrase('postings') }}</a>
                    <!--[XF:tabs:after_recent_content]-->
                    <xf:if is="$xf.visitor.canViewWarnings() && $user.warning_count">
                        <a href="{{ link('members/warnings', $user) }}" class="tabs-tab" id="warnings" role="tab">{{ phrase('warnings') }}</a>
                    </xf:if>
                    <!--[XF:tabs:end]-->
                </span>
            </h2>

            <ul class="tabPanes js-memberTabPanes">
                <!--[XF:tab_panes:start]-->
                <xf:if is="$user.canViewPostsOnProfile()">
                    <li class="is-active" role="tabpanel" id="profile-posts">
                        <xf:js src="xf/inline_mod.js" min="1" />
                        <xf:macro id="lightbox_macros::setup" arg-canViewAttachments="{$canViewAttachments}" />
                        <div class="block block--messages"
                            data-xf-init="lightbox inline-mod"
                            data-type="profile_post"
                            data-href="{{ link('inline-mod') }}">
                            <div class="block-container">
                                <div class="block-body js-replyNewMessageContainer">
                                    <xf:if is="$user.canPostOnProfile()">
                                        <xf:set var="$firstProfilePost" value="{$profilePosts|first}" />
                                        <xf:macro id="profile_post_macros::quick_post"
                                            arg-user="{$user}"
                                            arg-lastDate="{{ $firstProfilePost.post_date ?: 0 }}"
                                            arg-containerSelector="< .js-replyNewMessageContainer"
                                            arg-attachmentData="{$attachmentData}" />
                                    </xf:if>
                                    <xf:if is="$profilePosts is not empty">
                                        <xf:foreach loop="$profilePosts" value="$profilePost">
                                            <xf:macro id="profile_post_macros::{{ $profilePost.message_state == 'deleted' ? 'profile_post_deleted' : 'profile_post' }}"
                                                arg-attachmentData="{$profilePostAttachData.{$profilePost.profile_post_id}}"
                                                arg-profilePost="{$profilePost}" />
                                        </xf:foreach>
                                    <xf:else />
                                        <div class="block-row js-replyNoMessages">{{ phrase('there_no_messages_on_xs_profile_yet', {'name': $user.username}) }}</div>
                                    </xf:if>
                                </div>
                            </div>
                            <div class="block-outer block-outer--after">
                                <xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="members" data="{$user}" wrapperclass="block-outer-main" />
                                <div class="block-outer-opposite">
                                    <xf:showignored />
                                    <xf:if is="$canInlineMod"><xf:macro id="inline_mod_macros::button" /></xf:if>
                                </div>
                            </div>
                        </div>
                    </li>
                </xf:if>

                <xf:if is="$user.canViewLatestActivity()">
                    <xf:if is="!$user.canViewPostsOnProfile()">
                        <li class="is-active" role="tabpanel" id="latest-activity">
                            <div class="block"><div class="block-container">
                                <xf:if is="$newsFeedItems is not empty">
                                    <ul class="block-body js-newsFeedTarget">
                                        <xf:foreach loop="$newsFeedItems" value="$item">
                                            <xf:macro id="news_feed_macros::feed_row" arg-item="{$item}" />
                                        </xf:foreach>
                                    </ul>
                                    <div class="block-footer js-newsFeedLoadMore">
                                        <span class="block-footer-controls">
                                            <xf:button href="{{ link('members/latest-activity', $user, {'before_id': $newsFeedOldestItemId}) }}" rel="nofollow" data-xf-click="inserter" data-append=".js-newsFeedTarget" data-replace=".js-newsFeedLoadMore">{{ phrase('show_older_items') }}</xf:button>
                                        </span>
                                    </div>
                                <xf:else />
                                    <div class="block-body js-newsFeedTarget"><div class="block-row">{{ phrase('news_feed_is_currently_empty') }}</div></div>
                                </xf:if>
                            </div></div>
                        </li>
                    <xf:else />
                        <li data-href="{{ link('members/latest-activity', $user) }}" role="tabpanel" aria-labelledby="latest-activity">
                            <div class="blockMessage">{{ phrase('loading...') }}</div>
                        </li>
                    </xf:if>
                </xf:if>

                <li data-href="{{ link('members/recent-content', $user) }}" role="tabpanel" aria-labelledby="recent-content">
                    <div class="blockMessage">{{ phrase('loading...') }}</div>
                </li>

                <!--[XF:tab_panes:after_recent_content]-->

                <xf:if is="$xf.visitor.canViewWarnings() && $user.warning_count">
                    <li data-href="{{ link('members/warnings', $user) }}" role="tabpanel" aria-labelledby="warnings">
                        <div class="blockMessage">{{ phrase('loading...') }}</div>
                    </li>
                </xf:if>
                <!--[XF:tab_panes:end]-->
            </ul>

        </div>

        <!-- ── RIGHT SIDEBAR ── -->
        <div class="cc-profile-right">

            <!-- Years of Service -->
            <xf:if is="cc_yos($user.register_date) > 0">
                <div class="cc-sidebar-card cc-yos-sidebar-card year-{{ cc_yos($user.register_date) }}">
                    <div class="dp-service-badge-profile">
                        <div class="dp-service-badge-icon">
                            <svg width="27" height="19" viewBox="0 0 27 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2.36011 0.449047L6.04499 5.72473L13.2986 0L20.5523 5.72473L24.2371 0.449047L26.597 5.72473L19.8109 12.0597H6.78631L0.000244141 5.72473L2.36011 0.449047Z" fill="currentColor"/>
                                <path d="M7.6167 13.4965H19.3804V15.3497C19.3804 16.3647 18.5548 17.1903 17.5398 17.1903H9.45726C8.44224 17.1903 7.6167 16.3647 7.6167 15.3497V13.4965Z" fill="currentColor"/>
                            </svg>
                        </div>
                        <div class="dp-service-badge-duration">{{ cc_yos($user.register_date) }}</div>
                        <div class="dp-service-badge-title">Years of Service</div>
                    </div>
                </div>
            </xf:if>

            <xf:widgetpos id="member_view_right_sidebar" />

        </div>

    </div>
</div>]]></replace>
  </modification>
</template_modifications>
