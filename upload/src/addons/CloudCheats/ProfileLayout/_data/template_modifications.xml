<script>
(function(){
    function initVbTabs(){
        document.querySelectorAll('[data-profile-tabs]').forEach(function(block){
            if(block.dataset.ptInit) return;
            block.dataset.ptInit = '1';
            var tabs   = block.querySelectorAll('.profile-tab');
            var panels = block.querySelectorAll('.profile-tab-panel');
            tabs.forEach(function(tab, i){
                tab.addEventListener('click', function(){
                    tabs.forEach(function(t){ t.classList.remove('is-active'); });
                    panels.forEach(function(p){ p.classList.remove('is-active','is-entering'); });
                    tab.classList.add('is-active');
                    if(panels[i]){ panels[i].classList.add('is-active','is-entering'); }
                });
            });
        });
    }
    if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', initVbTabs);
    } else {
        initVbTabs();
    }
})();

    // CC: Mark/Unmark as Scammer — submit as hidden form so CSRF + redirect work natively
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.js-ccScammerToggle');
        if (!btn) return;
        e.preventDefault();
        var label    = btn.querySelector('.cc-scammer-link');
        var isMarked = label && label.textContent.indexOf('Unmark') >= 0;
        var form = document.createElement('form');
        form.method = 'post';
        form.action = btn.href;
        var fields = {
            user_id:  btn.dataset.userId,
            action:   isMarked ? 'unmark' : 'mark',
            _xfToken: btn.dataset.xfToken
        };
        Object.keys(fields).forEach(function(k) {
            var inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = k; inp.value = fields[k];
            form.appendChild(inp);
        });
        document.body.appendChild(form);
        form.submit();
    });
</script>

