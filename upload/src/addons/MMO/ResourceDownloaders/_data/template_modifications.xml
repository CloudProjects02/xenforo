    <replace><![CDATA[<div class="p-footer-copyright cb-addon-copyright"  data-copyright-url="https://xenforoleaks.net" style="display:block;text-align:center;font-size:12px;line-height:1.45;letter-spacing:.01em;margin:10px auto 6px;padding:4px 8px;max-width:100%;word-break:break-word;opacity:.92;color:inherit;">[MMO] Who Downloaded This Resource <a class="u-concealed" style="color:inherit;text-decoration:underline;text-underline-offset:2px;" rel="nofollow noopener" href="https://xenforoleaks.net" target="_blank">Addon provided by Homicide ©2026</a></div><script>(function(){if(window.__copyrightBuilderDedupInitialized){return;}window.__copyrightBuilderDedupInitialized=true;var TRACKING_PARAM_PATTERN=/^(utm_[a-z0-9_]+|fbclid|gclid|dclid|msclkid|mc_cid|mc_eid)$/i;function normalizeUrl(raw){if(!raw){return '';}var trimmed=String(raw).trim();if(!trimmed){return '';}try{var parsed=new URL(trimmed, window.location.origin);var host=parsed.hostname.toLowerCase().replace(/^www\./, '');var port=parsed.port;if((parsed.protocol==='http:'&&port==='80')||(parsed.protocol==='https:'&&port==='443')){port='';}var pathname=parsed.pathname.replace(/\/+$/, '');if(!pathname){pathname='/';}var queryParts=[];parsed.searchParams.forEach(function(value, key){if(TRACKING_PARAM_PATTERN.test(key)){return;}queryParts.push([key, value]);});queryParts.sort(function(left, right){if(left[0]===right[0]){return left[1]<right[1]?-1:left[1]>right[1]?1:0;}return left[0]<right[0]?-1:1;});var normalizedQuery='';if(queryParts.length){normalizedQuery='?'+queryParts.map(function(entry){return encodeURIComponent(entry[0])+'='+encodeURIComponent(entry[1]);}).join('&');}return host+(port?':'+port:'')+pathname+normalizedQuery;}catch(_error){return trimmed.toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/#.*$/, '').replace(/\/+$/, '');}}function dedupeCopyrightBlocks(){var seen=Object.create(null);var blocks=document.querySelectorAll('.cb-addon-copyright');for(var index=0; index<blocks.length; index+=1){var block=blocks[index];var anchor=block.querySelector('a[href]');var rawUrl=(block.getAttribute('data-copyright-url')||'').trim();if(!rawUrl&&anchor){rawUrl=anchor.getAttribute('href')||anchor.href||'';}var key=normalizeUrl(rawUrl);if(!key){continue;}if(seen[key]){block.remove();continue;}seen[key]=true;}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded', dedupeCopyrightBlocks, {once:true});}else{dedupeCopyrightBlocks();}})();</script>
