  </style_property>
  <style_property property_name="svIncludeStockStylingForAlerts" group_name="svAlertImprovements" title="Include stock styling for read/unread/recently-read alerts" description="The &quot;extra&quot; section support only pure LESS, which prevents use of &lt;i&gt;.xf-contentHighlightBase();&lt;/i&gt;/&lt;i&gt;.xf-contentAltBase();&lt;/i&gt; in the style property. As such, these are included in the template and this option controls if they are used." property_type="value" value_type="boolean" has_variations="0" display_order="10">
    <value>1</value>
  </style_property>
  <style_property property_name="svReadAlerts" group_name="svAlertImprovements" title="Read alerts" property_type="css" has_variations="0" display_order="1020" css_components="text,background,border,border_radius,padding,extra">
