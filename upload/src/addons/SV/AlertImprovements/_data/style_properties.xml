  <style_property property_name="svAlertImprovJustReadAlertFlag" group_name="svAlertImprovements" title="Show &quot;just toggled read alert&quot; icon on alert" description="When toggling the alert's read status to read" property_type="value" value_type="boolean" has_variations="0" value_group="JustToggledReadAlertIcon" display_order="400">
