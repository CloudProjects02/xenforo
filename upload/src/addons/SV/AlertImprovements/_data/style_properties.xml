  <style_property property_name="svFadeJustReadDelay" group_name="svAlertImprovements" title="Just-read alert transition delay" property_type="value" value_type="number" has_variations="0" depends_on="svFadeJustReadToRead" value_group="JustReadAlerts" display_order="130">
    <value_parameters>min=0
step=any
data-step=0.1
units={{ phrase('units_seconds') }}</value_parameters>
    <value>"2.5"</value>
  </style_property>
  <style_property property_name="svFadeJustReadDuration" group_name="svAlertImprovements" title="Just-read alert transition duration" description="Duration the transition to fade the is-just-read before removing it.&lt;br/&gt;&#10;0 to fade immediately" property_type="value" value_type="number" has_variations="0" depends_on="svFadeJustReadToRead" value_group="JustReadAlerts" display_order="120">
