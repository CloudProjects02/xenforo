<?xml version="1.0" encoding="utf-8"?>
<routes>
  <route route_type="admin" route_prefix="anti-spam" controller="SV\SignupAbuseBlocking:AntiSpam" context="svAntiSpam"/>
  <route route_type="admin" route_prefix="anti-spam" sub_name="multi-accounts" format="multi-accounts/:int&lt;user_id&gt;/" controller="SV\SignupAbuseBlocking:MultiAccount" context="svAntiSpamMultiAccount"/>
  <route route_type="admin" route_prefix="anti-spam" sub_name="option" format="option/:str&lt;option_id&gt;/" controller="SV\SignupAbuseBlocking:AntiSpam" context="svAntiSpamOptions" action_prefix="option"/>
