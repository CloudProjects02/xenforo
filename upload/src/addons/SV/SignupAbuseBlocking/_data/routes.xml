  <route route_type="admin" route_prefix="logs" sub_name="user-registration" format="user-registration/:int&lt;user_registration_log_id&gt;/" controller="XF:Log" context="userRegistrationLog" action_prefix="userRegistration"/>
  <route route_type="public" route_prefix="login" sub_name="connected-accounts" format="register/connected-accounts/:str&lt;provider_id&gt;/" controller="XF:Login" action_prefix="RegisterConnectedAccounts"/>
  <route route_type="public" route_prefix="members" sub_name="multiple-account-list" format=":int&lt;user_id,username&gt;/multiple-account-list/:page" controller="XF:Member" context="members" action_prefix="MultipleAccountList"/>
</routes>
 		 		 	   	 	  		  				  	 	 		 	 	   	    	 	  	 	  	 	 	 			    	 				 		    			 	 	  		  		  	 	 			 	   		  	 	 	  	 	   	 	 	 
